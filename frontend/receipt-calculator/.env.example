# Copy to .env.local (never commit). Same pattern as production: proxy only, no browser Google key.

# ReceiptCalculator.Api base URL — no trailing slash.
# Local: prefer http://localhost:5188 + `dotnet run --launch-profile http` (HTTPS dev cert often causes "Failed to fetch").
# Production: GitHub Actions sets this from RECEIPT_CALCULATOR_API_URL (your Railway https URL).
# VITE_VISION_PROXY_URL=http://localhost:5188

# Server (Railway or local user-secrets): Vision:ApiKey, Vision:DailyScanLimit, Vision:MonthlyScanLimit

# Optional support link (Buy Me a Coffee, Ko-fi, GitHub Sponsors, etc.)
# VITE_SUPPORT_URL=https://www.buymeacoffee.com/yourusername

# Optional Google AdSense — client matches <script> in index.html; slot from AdSense → Ads → Ad units
# VITE_ADSENSE_CLIENT=ca-pub-9714606930302346
# VITE_ADSENSE_SLOT=xxxxxxxxxx
